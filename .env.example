PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/smartdesk
# Required in production: a long random string (32+ characters), e.g. `openssl rand -hex 32`.
# If it is missing or left as this placeholder, the server uses a random one and signs everyone out on restart.
JWT_SECRET=change-me-to-a-long-random-string
# Device keys: once every desk is flashed with its key (Dashboard > Devices > Generate key),
# set this to true so desks without a key are refused.
REQUIRE_DEVICE_KEYS=false
# Optional: creates the first admin on an empty database (8+ character password).
ADMIN_EMAIL=
ADMIN_PASSWORD=
CORS_ORIGIN=*
DEVICE_OFFLINE_THRESHOLD_SECONDS=120
# Face ID: max face-template distance that counts as the same person (lower = stricter)
FACE_MATCH_THRESHOLD=0.45
